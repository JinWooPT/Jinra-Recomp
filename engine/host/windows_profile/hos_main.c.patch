+static void preview_runtime_profile(int argc, char **argv) {
+    for (int i = 1; i < argc; ++i)
+        if (!strcmp(argv[i], "--prepare-shaders")) return;
+    char directory[MAX_PATH], driver[MAX_PATH], hyrule[MAX_PATH], kakariko[MAX_PATH];
+    const DWORD length = hos_game_path_a(directory, MAX_PATH);
+    if (!length || length >= MAX_PATH) return;
+    char *last = strrchr(directory, SEP);
+    if (!last) return;
+    *last = 0;
+    if (snprintf(driver, sizeof driver, "%s\\jinra-previa-ram\\driver", directory) >= sizeof driver ||
+        snprintf(hyrule, sizeof hyrule, "%s\\jinra-previa-ram\\planicie.txt", directory) >= sizeof hyrule ||
+        snprintf(kakariko, sizeof kakariko, "%s\\jinra-previa-ram\\kakariko.txt", directory) >= sizeof kakariko) return;
+    const DWORD attr = GetFileAttributesA(driver);
+    if (attr == INVALID_FILE_ATTRIBUTES || !(attr & FILE_ATTRIBUTE_DIRECTORY) ||
+        GetFileAttributesA(hyrule) == INVALID_FILE_ATTRIBUTES || GetFileAttributesA(kakariko) == INVALID_FILE_ATTRIBUTES) return;
+    if (!getenv("__GL_SHADER_DISK_CACHE_PATH")) {
+        _putenv_s("__GL_SHADER_DISK_CACHE_PATH", driver);
+        SetEnvironmentVariableA("__GL_SHADER_DISK_CACHE_PATH", driver);
+        SetEnvironmentVariableA("__GL_SHADER_DISK_CACHE", "1");
+    }
+    preview_default("JINRA_PREVIEW_RAM", "1");
+    if (!profile_activate(directory)) {
+        preview_default("RX_VK_PCACHE_LOAD", "0");
+        preview_default("JINRA_TEST_WARM_EMPTY_CACHE", "1");
+    } else if (getenv("RX_VK_PCACHE_LOAD") && !strcmp(getenv("RX_VK_PCACHE_LOAD"), "0")) {
+        preview_default("JINRA_TEST_WARM_EMPTY_CACHE", "1");
+    }
+    preview_default("JINRA_TEST_SCENE_TRIGGER", "1");
+    preview_default("JINRA_TEST_SCENE_KEYS", hyrule);
+    preview_default("JINRA_TEST_KAKARIKO_KEYS", kakariko);
+    preview_default("JINRA_TEST_SHADOW_SWEEP_BOUNDED", "1");
+    preview_default("JINRA_TEST_SMALL_COPY_ONLY", "1");
+    preview_default("JINRA_TEST_COPY_64K", "1");
+    preview_default("RX_VK_SMALL_COPY_PHASE", "1");
+    preview_default("RX_VK_RT_SMALL_POOL", "1");
+}
