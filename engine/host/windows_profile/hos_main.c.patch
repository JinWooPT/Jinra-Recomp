+#include <bcrypt.h>
+static const char *profile_message;
+
+static int profile_file(const char *path) {
+    DWORD attrs = GetFileAttributesA(path);
+    return attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static int profile_activate(const char *directory) {
+    char profile[MAX_PATH], script[MAX_PATH], python[MAX_PATH], work[MAX_PATH], tmp[MAX_PATH];
+    char pending[MAX_PATH + 40], pipe[84], command[MAX_PATH * 4 + 96];
+    const char *local = getenv("LOCALAPPDATA");
+    if (snprintf(profile, sizeof profile, "%s\\jinra-perfil-015", directory) >= sizeof profile ||
+        snprintf(script, sizeof script, "%s\\gestao.py", profile) >= sizeof script || !profile_file(script)) return 0;
+    preview_default("JINRA_TEST_FIRST_VISIT_WAITS", "1");
+    preview_default("JINRA_TEST_FIFO_CADENCE", "1");
+    preview_default("JINRA_TEST_EARLY_READBACK", "1");
+    preview_default("JINRA_TEST_TARGET_SHAPE_REUSE", "1");
+    preview_default("JINRA_TEST_SHARED_CAPTURE", "1");
+    if (getenv("JINRA_TEST_RESOURCE_BATCH_PATH")) {
+        profile_message = "gestao de recursos fornecida pela sessao externa.";
+        return 1;
+    }
+    profile_message = "gestao seletiva indisponivel; restantes opcoes carregadas.";
+    if (snprintf(python, sizeof python, "%s\\python\\python.exe", profile) >= sizeof python) return 1;
+    if (!profile_file(python)) {
+        const char *provided = getenv("JINRA_PROFILE_PYTHON");
+        const char *base = provided ? strrchr(provided, '\\') : NULL;
+        const char *slash = provided ? strrchr(provided, '/') : NULL;
+        if (slash && (!base || slash > base)) base = slash;
+        if (provided && strlen(provided) < sizeof python && base && !_stricmp(base + 1, "python.exe") &&
+            ((provided[0] && provided[1] == ':' && (provided[2] == '\\' || provided[2] == '/'))) &&
+            profile_file(provided)) {
+            strcpy(python, provided);
+        } else if (!local || snprintf(python, sizeof python, "%s\\Jinra-Recomp\\kit\\0.1.8-4aee236\\tools\\python\\python.exe", local) >= sizeof python ||
+                   !profile_file(python)) return 1;
+    }
+    const DWORD tmp_len = GetTempPathA(sizeof tmp, tmp);
+    if (!tmp_len || tmp_len >= sizeof tmp) return 1;
+    const DWORD pid = GetCurrentProcessId();
+    unsigned char random[16];
+    if (BCryptGenRandom(NULL, random, sizeof random, BCRYPT_USE_SYSTEM_PREFERRED_RNG) < 0) return 1;
+    char token[33];
+    for (int i = 0; i < 16; i++) snprintf(token + i * 2, 3, "%02x", random[i]);
+    if (snprintf(work, sizeof work, "%sJinra-015-%lu-%s", tmp, (unsigned long)pid, token) >= sizeof work) return 1;
+    if (snprintf(pending, sizeof pending, "%s\\pending-resources.bin", work) >= sizeof pending) return 1;
+    if (snprintf(command, sizeof command, "\"%s\" -I -B -S \"%s\" %lu \"%s\"", python, script, (unsigned long)pid, work) >= sizeof command) return 1;
+    if (!CreateDirectoryA(work, NULL)) return 1;
+    const char *external = getenv("HOS_CONTROL");
+    if (!external || !*external) {
+        snprintf(pipe, sizeof pipe, "jinra-recursos-%lu-%s", (unsigned long)pid, token);
+        _putenv_s("HOS_CONTROL", pipe);
+        _putenv_s("JINRA_PRIVATE_RESOURCE_PIPE", "1");
+    }
+    _putenv_s("JINRA_TEST_RESOURCE_BATCH_PATH", pending);
+    preview_default("JINRA_TEST_RESOURCE_QUEUE", "1");
+    preview_default("JINRA_TEST_RESOURCE_REFERENCES", "1");
+    preview_default("JINRA_TEST_RESOURCE_RESIDENT_LINKS", "1");
+    preview_default("JINRA_TEST_RESOURCE_BROAD", "1");
+    preview_default("JINRA_TEST_RESOURCE_DECOMMIT", "1");
+    preview_default("JINRA_TEST_GUEST_RAM_AUDIT", "@jinra-memory-only");
+    STARTUPINFOA startup = {0};
+    PROCESS_INFORMATION child = {0};
+    startup.cb = sizeof startup;
+    if (!CreateProcessA(python, command, NULL, NULL, FALSE, CREATE_NO_WINDOW | BELOW_NORMAL_PRIORITY_CLASS,
+                        NULL, profile, &startup, &child)) {
+        RemoveDirectoryA(work);
+        return 1;
+    }
+    CloseHandle(child.hThread);
+    CloseHandle(child.hProcess);
+    profile_message = "perfil nativo ativo; gestor seletivo iniciado.";
+    return 1;
+}
