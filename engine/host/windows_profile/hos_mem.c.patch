+        LIFE('M', lo, hi - lo);
+    } else {
+        const DWORD status = discard ? discard(GP(lo), (SIZE_T)(hi - lo)) : ERROR_CALL_NOT_IMPLEMENTED;
+        if (status == ERROR_SUCCESS) {
+            if (sample) LIFE('K', lo, hi - lo);
+        } else {
+            void *reset = VirtualAlloc(GP(lo), (SIZE_T)(hi - lo), MEM_RESET, PAGE_READWRITE);
+            if (sample) LIFE(reset ? 'R' : 'E', lo, reset ? hi - lo : GetLastError());
+        }
+    }
+    if (sample) LIFE('O', lo, jinra_resource_resident(lo, hi));
