+#ifdef _WIN32
+#include <psapi.h>
+extern uint64_t jinra_resource_release_base(void);
+
+static uint64_t jinra_resource_resident(uint64_t lo, uint64_t hi) {
+    PSAPI_WORKING_SET_EX_INFORMATION addresses[4096];
+    const size_t count = (size_t)((hi - lo) >> 12);
+    if (!count || count > 4096) return UINT64_MAX;
+    for (size_t i = 0; i < count; ++i) {
+        addresses[i].VirtualAddress = GP(lo + (i << 12));
+        addresses[i].VirtualAttributes.Flags = 0;
+    }
+    if (!K32QueryWorkingSetEx(GetCurrentProcess(), addresses, (DWORD)(count * sizeof(addresses[0]))))
+        return UINT64_MAX;
+    uint64_t pages = 0;
+    for (size_t i = 0; i < count; ++i) pages += addresses[i].VirtualAttributes.Valid;
+    return pages << 12;
+}
+#endif
