+#ifdef _WIN32
+typedef struct {
+    volatile LONG ready;
+    uint64_t lo, length, caller;
+    int64_t at_ns;
+    char action;
+    uint32_t native_thread;
+} GuestRamEvent;
+enum { lifecycle_event_capacity = 524288 };
+static GuestRamEvent ram_events[lifecycle_event_capacity];
+static volatile LONG ram_event_count;
+static const char* ram_audit_file;
+static uint64_t ram_module_base;
+
+#include <string.h>
+
+enum { allocation_stack_capacity = 32768, allocation_stack_depth = 12 };
+
+typedef struct {
+    volatile LONG ready;
+    int64_t allocation_ns, elapsed_ns;
+    uint64_t address, bytes, thread_name_hash, resource_node, resource_key, return_pc[allocation_stack_depth];
+    uint32_t thread;
+    unsigned depth;
+    char stop;
+} AllocationStack;
+
+static AllocationStack allocation_stacks[allocation_stack_capacity];
+static volatile LONG allocation_stack_count;
+static int observe_allocation_stacks;
+static int observe_allocation_stacks_full;
+static int observe_allocation_resource_names;
+static __declspec(thread) int64_t last_allocation_ns;
+static __declspec(thread) unsigned small_allocation_count;
+
+static int guest_return_pc(uint64_t pc) {
+    return pc >= hos_image_base && pc < hos_image_end && !(pc & 3);
+}
+
+static uint64_t allocation_resource_key(uint64_t node) {
+    uint8_t fields[12];
+    if (!ReadProcessMemory(GetCurrentProcess(), GP(node + 0x2e0), fields, sizeof fields, NULL)) return 0;
+    uint64_t name_address;
+    uint32_t name_size;
+    memcpy(&name_address, fields, sizeof name_address);
+    memcpy(&name_size, fields + sizeof name_address, sizeof name_size);
+    unsigned char name[512];
+    if (name_address < 0x10000 || name_size < 2 || name_size > sizeof name ||
+        !hos_guest_range(name_address, name_size) ||
+        !ReadProcessMemory(GetCurrentProcess(), GP(name_address), name, name_size, NULL)) return 0;
+
+    uint64_t hash = 14695981039346656037ull;
+    for (uint32_t index = 0; index < name_size; index++) {
+        if (!name[index]) return index ? hash : 0;
+        if (name[index] < 0x20 || name[index] > 0x7e) return 0;
+        hash = (hash ^ name[index]) * 1099511628211ull;
+    }
+    return 0;
+}
+
+void jinra_ram_allocation_stack(Ctx *ctx, uint64_t address, uint64_t bytes) {
+    if (!observe_allocation_stacks || !last_allocation_ns || bytes < (64u << 10)) return;
+    if (!observe_allocation_stacks_full && bytes < (512u << 10) && (++small_allocation_count & 15u)) return;
+    const int64_t started = hos_now_ns();
+    const LONG index = InterlockedIncrement(&allocation_stack_count) - 1;
+    if (index >= allocation_stack_capacity) return;
+    AllocationStack *entry = &allocation_stacks[index];
+    entry->allocation_ns = last_allocation_ns;
+    entry->address = address;
+    entry->bytes = bytes;
+    entry->thread = GetCurrentThreadId();
+
+    HosThread *thread = hos_self();
+    uint64_t stack_base = 0, stack_size = 0;
+    if (thread) {
+        hos_thread_stack(thread, &stack_base, &stack_size);
+        const char *name = hos_thread_name(thread);
+        if (name && *name) {
+            uint64_t hash = 14695981039346656037ull;
+            for (unsigned index = 0; index < 32 && name[index]; index++) {
+                hash = (hash ^ (unsigned char)name[index]) * 1099511628211ull;
+            }
+            entry->thread_name_hash = hash;
+        }
+    }
+    entry->stop = 'S';
+    if (stack_size < 16 || !hos_guest_range(stack_base, stack_size)) goto publish;
+
+    // The exact lifted function is verified offline. The image bounds reject invalid PCs here.
+    const uint64_t lr = ctx->x[30];
+    entry->stop = 'L';
+    if (!guest_return_pc(lr)) goto publish;
+    entry->return_pc[entry->depth++] = lr;
+
+    uint64_t fp = ctx->x[29];
+    const uint64_t sp = ctx->x[31];
+    while (entry->depth < allocation_stack_depth) {
+        if (!fp) { entry->stop = 'E'; break; }
+        if ((fp & 15) || fp < sp || fp < stack_base || fp - stack_base > stack_size - 16) {
+            entry->stop = 'F';
+            break;
+        }
+        uint64_t frame[2];
+        if (!ReadProcessMemory(GetCurrentProcess(), GP(fp), frame, sizeof frame, NULL)) {
+            entry->stop = 'R';
+            break;
+        }
+        if (!guest_return_pc(frame[1])) { entry->stop = 'L'; break; }
+        entry->return_pc[entry->depth++] = frame[1];
+        // The resource loader saves its caller's x19 at FP+24 before loading the node.
+        if (frame[1] == 0x801b69b4ULL && stack_size >= 32 && fp - stack_base <= stack_size - 32) {
+            uint64_t saved_node = 0;
+            if (ReadProcessMemory(GetCurrentProcess(), GP(fp + 24), &saved_node, sizeof saved_node, NULL) &&
+                saved_node && hos_guest_range(saved_node, 0x398)) {
+                entry->resource_node = saved_node;
+            }
+        }
+        if (frame[0] && frame[0] <= fp) { entry->stop = 'F'; break; }
+        fp = frame[0];
+    }
+    if (entry->depth == allocation_stack_depth) entry->stop = 'D';
+    if (observe_allocation_resource_names && entry->resource_node) {
+        entry->resource_key = allocation_resource_key(entry->resource_node);
+    }
+
+publish:
+    entry->elapsed_ns = hos_now_ns() - started;
+    InterlockedExchange(&entry->ready, 1);
+}
+
+static void write_allocation_stacks(void) {
+    if (!observe_allocation_stacks) return;
+    char path[4096];
+    int length = snprintf(path, sizeof path, "%s.stacks.csv", ram_audit_file);
+    if (length < 0 || (size_t)length >= sizeof path) return;
+    FILE *output = fopen(path, "wb");
+    if (!output) return;
+    const LONG total = InterlockedCompareExchange(&allocation_stack_count, 0, 0);
+    const LONG count = total < allocation_stack_capacity ? total : allocation_stack_capacity;
+    fprintf(stderr, "Jinra allocation stacks %ld total %d capacity\n", (long)total, allocation_stack_capacity);
+    fputs("at_ns,guest_lo,bytes,native_thread,thread_name_hash,resource_node,resource_key,elapsed_ns,stop,pcs\n", output);
+    for (LONG index = 0; index < count; index++) {
+        AllocationStack *entry = &allocation_stacks[index];
+        if (!InterlockedCompareExchange(&entry->ready, 0, 0)) continue;
+        fprintf(output, "%lld,%llx,%llu,%u,%llx,%llx,%llx,%lld,%c,", (long long)entry->allocation_ns,
+                (unsigned long long)entry->address, (unsigned long long)entry->bytes,
+                entry->thread, (unsigned long long)entry->thread_name_hash,
+                (unsigned long long)entry->resource_node, (unsigned long long)entry->resource_key,
+                (long long)entry->elapsed_ns, entry->stop);
+        for (unsigned depth = 0; depth < entry->depth; depth++) {
+            fprintf(output, "%s%llx", depth ? ":" : "", (unsigned long long)entry->return_pc[depth]);
+        }
+        fputc('\n', output);
+    }
+    fclose(output);
+}
+
+void ram_audit_finish(void) {
+    static volatile LONG written;
+    if (!ram_audit_file || InterlockedExchange(&written, 1)) return;
+    if (!strcmp(ram_audit_file, "@jinra-memory-only")) return;
+    write_allocation_stacks();
+    FILE* out = fopen(ram_audit_file, "wb");
+    if (!out) return;
+    fputs("at_ns,action,guest_lo,bytes,caller_rva,native_thread\n", out);
+    const LONG raw = InterlockedCompareExchange(&ram_event_count, 0, 0);
+    const LONG count = raw < lifecycle_event_capacity ? raw : lifecycle_event_capacity;
+    fprintf(stderr, "Jinra guest lifecycle %ld total %ld capacity\n", (long)raw, (long)lifecycle_event_capacity);
+    for (LONG i=0; i<count; ++i) {
+        const GuestRamEvent* row=&ram_events[i];
+        if (!InterlockedCompareExchange((volatile LONG*)&row->ready, 0, 0)) continue;
+        fprintf(out, "%lld,%c,%llx,%llu,%llx,%u\n", (long long)row->at_ns, row->action,
+                (unsigned long long)row->lo, (unsigned long long)row->length, (unsigned long long)row->caller, row->native_thread);
+    }
+    fclose(out);
+}
+
+uint64_t jinra_observed_allocation_size(uint64_t base, uint64_t *start) {
+    const LONG raw = InterlockedCompareExchange(&ram_event_count, 0, 0);
+    if (raw > lifecycle_event_capacity) return 0;
+    for (LONG i = raw; i > 0; --i) {
+        const GuestRamEvent *event = &ram_events[i - 1];
+        if (!InterlockedCompareExchange((volatile LONG *)&event->ready, 0, 0)) continue;
+        if (event->lo > base || base - event->lo >= event->length) continue;
+        if (event->action == 'A') {
+            *start = event->lo;
+            return event->length;
+        }
+        if (event->action == 'F' || event->action == 'L' || event->action == 'U') return 0;
+    }
+    return 0;
+}
+
+int jinra_observed_reacquisition(uint64_t node, uint64_t base, int64_t since) {
+    const LONG raw = InterlockedCompareExchange(&ram_event_count, 0, 0);
+    if (raw > lifecycle_event_capacity) return 1;
+    for (LONG i = raw; i > 0; --i) {
+        const GuestRamEvent *event = &ram_events[i - 1];
+        if (!InterlockedCompareExchange((volatile LONG *)&event->ready, 0, 0)) continue;
+        if (event->at_ns >= since && event->lo == node && (event->action == 'I' || event->action == 'J') &&
+            (!event->length || event->length == base)) return 1;
+    }
+    return 0;
+}
+
+void guest_ram_audit(char action, uint64_t lo, uint64_t length, uint64_t caller) {
+    if (action == 'A') last_allocation_ns = 0;
+    if (!ram_audit_file) return;
+    const LONG i=InterlockedIncrement(&ram_event_count)-1;
+    if (i>=lifecycle_event_capacity) return;
+    GuestRamEvent* row=&ram_events[i];
+    row->lo=lo;
+    row->length=length;
+    const int native_tag = action == 'f' || action == 'l' || action == 'n' ||
+                           action == 'b' || action == 'k' || action == 'i' || action == 'j' ||
+                           action == 'm' || action == 'q';
+    row->caller = native_tag ? caller : (caller >= ram_module_base ? caller - ram_module_base : 0);
+    const int captured_allocation = observe_allocation_stacks && action == 'A';
+    row->native_thread = native_tag || captured_allocation ? GetCurrentThreadId() : 0;
+    row->at_ns=hos_now_ns();
+    if (captured_allocation) last_allocation_ns = row->at_ns;
+    row->action=action;
+    InterlockedExchange(&row->ready,1);
+}
+#endif
