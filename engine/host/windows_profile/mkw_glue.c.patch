 void hos_commit_init(void) {
+#ifdef _WIN32
+    ram_audit_file = getenv("JINRA_TEST_GUEST_RAM_AUDIT");
+    if (ram_audit_file && *ram_audit_file) {
+        ram_module_base = (uint64_t)GetModuleHandleW(NULL);
+        observe_allocation_stacks = env_on("JINRA_TEST_ALLOC_STACKS");
+        observe_allocation_stacks_full = env_on("JINRA_TEST_ALLOC_STACKS_FULL");
+        observe_allocation_resource_names = env_on("JINRA_TEST_ALLOC_RESOURCE_NAMES");
+        atexit(ram_audit_finish);
+    } else ram_audit_file = NULL;
+#endif
