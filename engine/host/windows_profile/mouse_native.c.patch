+/* Optional diagnostics before the camera update, including when the right stick turns it. */
+static void trace_camera(uint64_t cam) {
+    static FILE *csv;
+    static int initialized;
+    if (!initialized) {
+        initialized = 1;
+        const char *path = getenv("HOS_JINRA_CAMERA_TRACE");
+        if (path && *path) csv = fopen(path, "w");
+        if (csv) fputs("frame,qpc_ns,camera,state,yaw,pitch\n", csv);
+    }
+    if (!cam || !looks_like_camera(cam) || (!csv && !env_on("RX_VK_SMALL_COPY_PHASE"))) return;
+    if (jinra_gap_enabled) jinra_gap_note("camera_entry", 0, hos_now_ns(), 0, 0, cam, 0);
+    extern volatile LONG64 hos_present_count;
+    const LONG64 frame = InterlockedCompareExchange64(&hos_present_count, 0, 0);
+    const int state = geti(cam + STATE_AT);
+    const int64_t now = hos_now_ns();
+    static int phase_enabled = -1;
+    if (phase_enabled < 0) phase_enabled = env_on("RX_VK_SMALL_COPY_PHASE");
+    if (phase_enabled) {
+        typedef void (*phase_fn)(uint64_t, uint64_t, int, int64_t);
+        static phase_fn phase;
+        if (!phase) {
+            HMODULE renderer = GetModuleHandleW(L"jinra_vk.dll");
+            if (renderer) phase = (phase_fn)GetProcAddress(renderer, "jinra_small_copy_camera");
+        }
+        if (phase) phase(cam, frame, state, now);
+    }
+    if (!csv) return;
+    fprintf(csv, "%lld,%lld,%llx,%d,%.7f,%.7f\n", (long long)frame, (long long)now,
+            (unsigned long long)cam, state, getf(cam + YAW_AT), getf(cam + PITCH_AT));
+    if (!(frame % 120)) fflush(csv);
+}
