+/* Laboratory batch, prepared once outside the resource worker. */
+enum { resource_batch_capacity = 2048, resource_batch_index_size = 4096 };
+typedef struct {
+    uint64_t node, base, proposed, since;
+} ResourceBatchInput;
+typedef struct {
+    ResourceBatchInput input;
+    uint64_t start, bytes;
+    volatile LONG excluded;
+} ResourceBatchEntry;
+
+static ResourceBatchEntry resource_batch[resource_batch_capacity];
+static unsigned resource_batch_index[resource_batch_index_size];
+static SRWLOCK resource_batch_index_lock = SRWLOCK_INIT;
+static unsigned resource_batch_count, resource_batch_cursor;
+static volatile LONG resource_batch_state, resource_batch_selected;
+static int resource_batch_observe;
+static int resource_batch_broad;
+static int64_t resource_batch_begin, resource_batch_end, resource_batch_next;
+
+static unsigned resource_batch_slot(uint64_t node) {
+    return (unsigned)(((node >> 3) * 0x9e3779b97f4a7c15ULL) >> 52);
+}
+
+static void resource_batch_invalidate(uint64_t node, uint64_t base) {
+    LONG state = InterlockedCompareExchange(&resource_batch_state, 0, 0);
+    if (state != 1 && state != 2) return;
+    if (!TryAcquireSRWLockShared(&resource_batch_index_lock)) return;
+    state = InterlockedCompareExchange(&resource_batch_state, 0, 0);
+    if (state == 1 || state == 2) {
+        unsigned slot = resource_batch_slot(node);
+        while (resource_batch_index[slot]) {
+            ResourceBatchEntry *entry = &resource_batch[resource_batch_index[slot] - 1];
+            if (entry->input.node == node) {
+                if (!base || entry->input.base == base) InterlockedExchange(&entry->excluded, 1);
+                break;
+            }
+            slot = (slot + 1) & (resource_batch_index_size - 1);
+        }
+    }
+    ReleaseSRWLockShared(&resource_batch_index_lock);
+}
+
+static DWORD WINAPI resource_batch_preflight(void *unused) {
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (unsigned i = 0; i < resource_batch_count; ++i) {
+        ResourceBatchEntry *entry = &resource_batch[i];
+        const ResourceBatchInput *input = &entry->input;
+        entry->bytes = jinra_observed_allocation_size(input->base, &entry->start);
+        if (!entry->bytes || entry->bytes != input->proposed || entry->bytes > (16u << 20) ||
+            jinra_observed_reacquisition(input->node, input->base, (int64_t)input->since))
+            InterlockedExchange(&entry->excluded, 1);
+    }
+    InterlockedExchange(&resource_batch_state, 2);
+    return 0;
+}
+
+int jinra_resource_arm_batch(const char *path, int observe, int64_t begin, int64_t end) {
+    LONG state = InterlockedCompareExchange(&resource_batch_state, 0, 0);
+    if ((state != 0 && state != 3) || InterlockedCompareExchange(&resource_batch_state, -1, state) != state) return 0;
+    AcquireSRWLockExclusive(&resource_batch_index_lock);
+    memset(resource_batch_index, 0, sizeof resource_batch_index);
+    resource_batch_count = resource_batch_cursor = 0;
+    InterlockedExchange(&resource_batch_selected, 0);
+    ReleaseSRWLockExclusive(&resource_batch_index_lock);
+    FILE *file = fopen(path, "rb");
+    int valid = 0;
+    if (file && !fseek(file, 0, SEEK_END)) {
+        const long length = ftell(file);
+        valid = length > 0 && (unsigned long)length % sizeof(ResourceBatchInput) == 0 &&
+                (unsigned long)length / sizeof(ResourceBatchInput) <= resource_batch_capacity && !fseek(file, 0, SEEK_SET);
+    }
+    ResourceBatchInput input;
+    while (valid && fread(&input, sizeof input, 1, file) == 1) {
+        if (resource_batch_count == resource_batch_capacity || !hos_guest_range(input.node, 0x398) ||
+            !hos_guest_range(input.base, 1) || !input.proposed || input.proposed > (16u << 20)) {
+            valid = 0;
+            break;
+        }
+        unsigned slot = resource_batch_slot(input.node);
+        while (resource_batch_index[slot] &&
+               resource_batch[resource_batch_index[slot] - 1].input.node != input.node)
+            slot = (slot + 1) & (resource_batch_index_size - 1);
+        if (resource_batch_index[slot]) {
+            valid = 0;
+            break;
+        }
+        resource_batch[resource_batch_count].input = input;
+        resource_batch[resource_batch_count].excluded = 0;
+        resource_batch_index[slot] = ++resource_batch_count;
+    }
+    if (file) {
+        if (ferror(file)) valid = 0;
+        fclose(file);
+    }
+    if (!valid || !resource_batch_count || end <= begin) {
+        InterlockedExchange(&resource_batch_state, 4);
+        return 0;
+    }
+    resource_batch_observe = observe;
+    resource_batch_broad = env_on("JINRA_TEST_RESOURCE_BROAD");
+    resource_batch_begin = begin;
+    resource_batch_next = begin;
+    resource_batch_end = end;
+    InterlockedExchange(&resource_batch_state, 1);
+    HANDLE worker = CreateThread(NULL, 0, resource_batch_preflight, NULL, 0, NULL);
+    if (!worker) {
+        InterlockedExchange(&resource_batch_state, 4);
+        return 0;
+    }
+    CloseHandle(worker);
+    return 1;
+}
+
+unsigned jinra_resource_batch_status(long *state) {
+    *state = InterlockedCompareExchange(&resource_batch_state, 0, 0);
+    return (unsigned)InterlockedCompareExchange(&resource_batch_selected, 0, 0);
+}
