+void jinra_record_reference_acquire(uint64_t node) {
+    if (!hos_guest_range(node, 0x398)) return;
+    const uint64_t base = G64(node + 0x390);
+    guest_ram_audit('I', node, base, 0);
+    jinra_state8_node_event('i', node, base, 0);
+    resource_batch_invalidate(node, base);
+}
