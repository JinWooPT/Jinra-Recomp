+static int resource_link_readable(uint64_t link) {
+    if ((link & 7) || !hos_guest_range(link, 16)) return 0;
+    MEMORY_BASIC_INFORMATION region;
+    const uintptr_t at = (uintptr_t)GP(link);
+    if (!VirtualQuery((const void *)at, &region, sizeof region) || region.State != MEM_COMMIT ||
+        (region.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return 0;
+    const uintptr_t distance = at - (uintptr_t)region.BaseAddress;
+    return distance <= region.RegionSize && region.RegionSize - distance >= 16;
+}
+
+static int resource_pages_resident(uint64_t address, size_t size) {
+    if (!hos_guest_range(address, size)) return 0;
+    PSAPI_WORKING_SET_EX_INFORMATION pages[2] = {{0}};
+    pages[0].VirtualAddress = GP(address);
+    pages[1].VirtualAddress = GP(address + size - 1);
+    if (!K32QueryWorkingSetEx(GetCurrentProcess(), pages, sizeof pages)) return 0;
+    for (unsigned i = 0; i < 2; ++i) {
+        const DWORD protection = (DWORD)pages[i].VirtualAttributes.Win32Protection;
+        if (!pages[i].VirtualAttributes.Valid || !protection || (protection & (PAGE_GUARD | PAGE_NOACCESS))) return 0;
+    }
+    return 1;
+}
+
+static int resource_readable_link(uint64_t link, int resident) {
+    if (link & 7) return 0;
+    return resident ? resource_pages_resident(link, 16) : resource_link_readable(link);
+}
