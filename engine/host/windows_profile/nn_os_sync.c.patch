+static void resource_references_observe(Ctx *c, uint64_t pc) {
+    const int increment_path = pc == 0x801b50f8;
+    const int decrement_path = pc == 0x801b8368 || pc == 0x801b8bb8;
+    const int destruction_path = pc == 0x801b90e4;
+    if ((!increment_path && !decrement_path && !destruction_path) ||
+        !env_on("JINRA_TEST_RESOURCE_REFERENCES")) return;
+    const uint64_t node = decrement_path ? c->x[20] : c->x[19];
+    if (!hos_guest_range(node, 0x398)) return;
+    const int32_t previous = (int32_t)G32(node + 0x90);
+    if (destruction_path) {
+        if (previous <= 0) {
+            const uint64_t base = G64(node + 0x390);
+            guest_ram_audit('N', node, base, 0);
+            if (env_on("JINRA_TEST_STATE8_LIFE")) {
+                const uint32_t state = G32(node + 0x10);
+                if (state == 8 || state == 9 || state == 11 || state == 12)
+                {
+                    guest_ram_audit('n', node, base, state);
+                    guest_ram_audit('q', node, G64(node + 0x68), pc);
+                }
+            }
+            resource_batch_invalidate(node, base);
+        }
+        return;
+    }
+    const int64_t next = (int64_t)previous + (increment_path ? (int32_t)c->x[20] : -1);
+    if (previous >= 0 && next >= 0 && ((previous == 0) != (next == 0))) {
+        const uint64_t base = G64(node + 0x390);
+        guest_ram_audit(next ? 'I' : 'J', node, base, 0);
+        jinra_state8_node_event(next ? 'i' : 'j', node, base, pc);
+        resource_batch_invalidate(node, base);
+    }
+}
