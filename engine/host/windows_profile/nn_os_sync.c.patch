+void jinra_state8_node_event(char type, uint64_t node, uint64_t data, uint64_t lr) {
+    static volatile LONG configured;
+    LONG mode = InterlockedCompareExchange(&configured, 0, 0);
+    if (!mode) {
+        const LONG selected = env_on("JINRA_TEST_STATE8_LIFE") ? 2 : 1;
+        const LONG previous = InterlockedCompareExchange(&configured, selected, 0);
+        mode = previous ? previous : selected;
+    }
+    if (mode == 2) guest_ram_audit(type, node, data, lr);
+}
