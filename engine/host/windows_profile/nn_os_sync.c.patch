+int jinra_resource_arm_observation(uint64_t node, uint64_t base, int64_t since, int native) {
+    if (!hos_guest_range(node, 0x398) || !hos_guest_range(base, 1)) return 0;
+    if (InterlockedCompareExchange(&single_state, -1, 0) != 0 &&
+        InterlockedCompareExchange(&single_state, -1, 2) != 2) return 0;
+    uint64_t start = 0;
+    const uint64_t bytes = jinra_observed_allocation_size(base, &start);
+    extern int rx_guest_imported(uint64_t lo, uint64_t hi);
+    const uint64_t maximum = native >= 3 ? (16u << 20) : (1u << 20);
+    if (native && (!since || bytes == 0 || bytes > maximum ||
+                   jinra_observed_reacquisition(node, base, since) || rx_guest_imported(start, start + bytes))) {
+        InterlockedExchange(&single_state, 0);
+        return 0;
+    }
+    single_node = node;
+    single_base = base;
+    InterlockedExchange(&single_state, native == 4 ? 6 : native >= 2 ? 4 : native ? 3 : 1);
+    return 1;
+}
