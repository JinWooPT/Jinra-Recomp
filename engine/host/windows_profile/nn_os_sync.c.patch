+static int resource_apply_candidate(Ctx *c, uint64_t manager, uint64_t head, LONG state) {
+    const int64_t start = hos_now_ns();
+    const uint32_t offset = G32(manager + 0x64);
+    if (offset != 0xb0) return 0;
+    const uint64_t link = single_node + offset;
+    static int resident = -1;
+    if (resident < 0) resident = env_on("JINRA_TEST_RESOURCE_RESIDENT_LINKS");
+    if (resident && !resource_pages_resident(single_node, 0x398)) return 0;
+    if (head != link) {
+        if ((state != 4 && state != 6) || !resource_readable_link(link, resident)) return 0;
+        const int64_t after_link = hos_now_ns();
+        const uint64_t prev = G64(link), next = G64(link + 8);
+        if (!resource_readable_link(prev, resident) || !resource_readable_link(next, resident) ||
+            G64(prev + 8) != link || G64(next) != link) return 0;
+        guest_ram_audit('x', single_node, (uint64_t)(after_link - start), 0);
+        guest_ram_audit('Z', single_node, (uint64_t)(hos_now_ns() - after_link), 0);
+    }
+    if (G64(single_node + 0x390) != single_base) return 0;
+    const uint8_t flags = *(const uint8_t *)GP(single_node + 5);
+    if (__atomic_load_n((const uint32_t *)GP(single_node + 0x90), __ATOMIC_ACQUIRE) != 0 ||
+        flags & 2 || G32(single_node + 0x10) != 11 || G32(single_node + 0xc) & 0x10000 ||
+        !(*(const uint8_t *)GP(single_node + 2) & 1) || !G64(single_node + 0x68) ||
+        G64(single_node + 0xc0) || G64(single_node + 0xc8)) return 0;
+    const int dry_run = state == 1 || state == 6;
+    guest_ram_audit(dry_run ? 'W' : 'V', single_node, single_base, 0);
+    guest_ram_audit('G', single_node, (uint64_t)(hos_now_ns() - start), 0);
+    if (state == 4) {
+        selected_link = link;
+        selected_manager = manager;
+    }
+    if (!dry_run) {
+        released_base = single_base;
+        c->x[25] = 1;
+    }
+    return 1;
+}
+
+static void resource_observe_candidate(Ctx *c, uint64_t manager, uint64_t head) {
+    const LONG state = InterlockedCompareExchange(&single_state, 0, 0);
+    if (!head || (state != 1 && state != 3 && state != 4 && state != 6) ||
+        InterlockedCompareExchange(&single_state, 5, state) != state) return;
+    InterlockedExchange(&single_state, resource_apply_candidate(c, manager, head, state) ? 2 : state);
+}
