+static void resource_batch_step(Ctx *c, uint64_t manager, uint64_t head) {
+    if (InterlockedCompareExchange(&resource_batch_state, 0, 0) != 2 || !head) return;
+    if (manager != jinra_resource_manager_observed()) return;
+    const int64_t now = hos_now_ns();
+    if (now >= resource_batch_end || resource_batch_cursor >= resource_batch_count) {
+        InterlockedExchange(&resource_batch_state, 3);
+        return;
+    }
+    if (now < resource_batch_begin || now < resource_batch_next) return;
+    if (InterlockedCompareExchange(&single_state, 0, 0) != 0) return;
+    typedef int (*PoolCheck)(uint64_t, uint64_t);
+    static PoolCheck no_import;
+    if (!no_import) {
+        HMODULE renderer = GetModuleHandleW(L"jinra_vk.dll");
+        no_import = renderer ? (PoolCheck)(void *)GetProcAddress(renderer, "jinra_resource_range_free") : NULL;
+        if (!no_import) {
+            InterlockedExchange(&resource_batch_state, 4);
+            return;
+        }
+    }
+    for (unsigned attempts = 0; attempts < 8 && resource_batch_cursor < resource_batch_count; ++attempts) {
+        ResourceBatchEntry *entry = &resource_batch[resource_batch_cursor];
+        if (InterlockedCompareExchange(&entry->excluded, 0, 0)) {
+            ++resource_batch_cursor;
+            continue;
+        }
+        const int safe = no_import(entry->start, entry->start + entry->bytes);
+        const int64_t checked = hos_now_ns();
+        if (safe < 0) return;
+        ++resource_batch_cursor;
+        if (!safe) continue;
+        single_node = entry->input.node;
+        single_base = entry->input.base;
+        if (!resource_apply_candidate(c, manager, head, resource_batch_observe ? 6 : 4)) continue;
+        guest_ram_audit('S', single_node, (uint64_t)(checked - now), 0);
+        InterlockedIncrement(&resource_batch_selected);
+        const unsigned bandwidth = (resource_batch_broad ? 32u : 12u) << 20;
+        const int64_t gap = resource_batch_broad ? 12000000 : 45000000;
+        const int64_t interval = (int64_t)(entry->bytes * 1000000000ULL / bandwidth);
+        resource_batch_next = now + (interval > gap ? interval : gap);
+        return;
+    }
+}
