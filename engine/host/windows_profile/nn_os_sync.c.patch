+static void resource_queue_observe(Ctx *c) {
+    const uint64_t pc = c->x[30];
+    switch (pc) {
+        case 0x801b69d0: case 0x801b6a88:
+        case 0x801b50f8: case 0x801b8368: case 0x801b8bb8: case 0x801b90e4:
+        case 0x801bae8c: case 0x801baed4: case 0x801baf7c: break;
