+typedef int (*phase_measure_fn)(int64_t*, int64_t*, uint64_t*);
+typedef void (*phase_tag_fn)(uint64_t*, uint64_t*, uint64_t*);
+
+static void display_present_tag(uint64_t *chain, uint64_t *id, uint64_t *sequence) {
+    static phase_tag_fn fn;
+    if (!fn) {
+        HMODULE vk = GetModuleHandleW(L"jinra_vk.dll");
+        if (vk) fn = (phase_tag_fn)GetProcAddress(vk, "jinra_display_present_tag");
+    }
+    if (fn) fn(chain, id, sequence);
+}
+
+static int64_t display_vsync_period(int64_t nominal, unsigned tick) {
+    static phase_measure_fn fn;
+    static int active;
+    if (!fn && tick % 60 == 0) {
+        HMODULE vk = GetModuleHandleW(L"jinra_vk.dll");
+        if (vk) fn = (phase_measure_fn)GetProcAddress(vk, "jinra_display_phase");
+    }
+    uint64_t id;
+    int64_t refresh, latency;
+    const int ok = fn && fn(&refresh, &latency, &id) &&
+                   llabs(4 * refresh - nominal) < 250000;
+    if (!ok) {
+        if (active) hos_log("vi: phase lock waiting for a fresh timing sample");
+        active = 0;
+        return nominal;
+    }
+    int64_t adjustment = (latency - refresh / 2) / 10;
+    if (adjustment > 500000) adjustment = 500000;
+    if (adjustment < -500000) adjustment = -500000;
+    if (!active || tick % 60 == 0)
+        hos_log("vi: phase lock tick %u id %llu refresh %lld latency %lld adjust %lld",
+                tick, (unsigned long long)id, (long long)refresh, (long long)latency, (long long)adjustment);
+    active = 1;
+    return 4 * refresh + adjustment;
+}
