--- nvdrv.c
+++ nvdrv.c
@@ -169,6 +169,24 @@
     UNLOCK();
 }
 
+__declspec(dllexport) int jinra_ram_mapped_ranges(uint64_t (*out)[2], int capacity, uint32_t* generation) {
+    AcquireSRWLockShared(&lock);
+    const int total = nmaps + ntracked;
+    *generation = (uint32_t)maps_generation;
+    if (out && capacity >= total) {
+        for (int i = 0; i < nmaps; ++i) {
+            out[i][0] = maps[i].guest & ~0xFFFULL;
+            out[i][1] = (maps[i].guest + maps[i].size + 0xFFF) & ~0xFFFULL;
+        }
+        for (int i = 0; i < ntracked; ++i) {
+            out[nmaps + i][0] = tracked[i].lo;
+            out[nmaps + i][1] = tracked[i].hi;
+        }
+    }
+    ReleaseSRWLockShared(&lock);
+    return total;
+}
+
 /* The guest memory the GPU can reach (every mapping's guest range, merged, page aligned), for the renderer's change
    tracking: GetWriteWatch over the whole guest arena cost ~2.5 ms a call, and the GPU only reads these. Returns
    the number of ranges (at most max) written to out as {start, end} pairs. */
