<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jinra-Recomp.UI</AssemblyName>
    <RootNamespace>JinraRecomp</RootNamespace>
    <Product>Jinra-Recomp</Product>
    <Description>Launcher e compilador local de Ocarina of Time para Windows</Description>
    <Version>0.1.9</Version>
    <ApplicationIcon>Assets/Jinra.ico</ApplicationIcon>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Jinra.ico;Assets/Jinra.png" />
    <Content Include="$(Payload)" Link="kit.zip" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
