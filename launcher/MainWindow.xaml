<Window x:Class="JinraRecomp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jinra-Recomp" Icon="Assets/Jinra.ico"
    Width="990" Height="715" MinWidth="820" MinHeight="590" WindowStartupLocation="CenterScreen"
    Background="{StaticResource Base}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Background="{StaticResource Base}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,25,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,30">
                    <Image Source="Assets/Jinra.png" Width="31" Height="31" Margin="0,0,8,0"/>
                    <TextBlock Text="Jinra-Recomp" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,0">
                    <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="Windows · Vulkan" Foreground="{StaticResource Muted}" Margin="0,5,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="BuildNav" Style="{StaticResource Nav}" Click="ShowBuild" Content="Compilação"/>
                    <Button x:Name="LogNav" Style="{StaticResource Nav}" Click="ShowLog" Content="Registo"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource Nav}" Click="CheckUpdates" Content="Atualizações"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer x:Name="BuildPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,24,26,22">
                    <Border CornerRadius="13" BorderBrush="#284865" BorderThickness="1" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#13243C" Offset="0"/>
                                <GradientStop Color="#10243B" Offset="0.58"/>
                                <GradientStop Color="#113C55" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Source="Assets/Jinra.png" Width="225" Height="225" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,-44,12,-44" Opacity="0.22" IsHitTestVisible="False"/>
                            <StackPanel Margin="22,19,22,21">
                                <TextBlock Text="THE LEGEND OF ZELDA" Foreground="{StaticResource Cyan}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="Ocarina of Time" FontWeight="Bold" FontSize="32" Margin="0,2,0,3"/>
                                <TextBlock Text="Nintendo Switch 2 · Versão 1.1.1" Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Cópia do jogo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceBox" IsReadOnly="True" VerticalContentAlignment="Center" MinHeight="38"
                                         AutomationProperties.Name="Caminho da cópia do jogo" TextChanged="SourceChanged"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="FileButton" Grid.Column="1" Margin="8,0,0,0" Content="Ficheiro…" Click="ChooseFile"/>
                                <Button x:Name="FolderButton" Grid.Column="2" Margin="8,0,0,0" Content="Pasta…" Click="ChooseFolder"/>
                            </Grid>
                            <TextBlock x:Name="SourceHint" Text="Arquivo .nx, .nup ou pasta com exefs e romfs. Podes arrastar a cópia para aqui."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <TextBlock Text="Destino" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DestinationBox" IsReadOnly="True" VerticalContentAlignment="Center" MinHeight="38"
                                         AutomationProperties.Name="Pasta de destino"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="DestinationButton" Grid.Column="1" Margin="8,0,0,0" Content="Alterar…" Click="ChooseDestination"/>
                            </Grid>
                            <WrapPanel Margin="0,13,0,0">
                                <CheckBox x:Name="WarmShaders" IsChecked="True" Margin="0,0,20,5" Content="Preparar shaders na compilação"/>
                                <CheckBox x:Name="Diagnostics" Margin="0,0,20,5" Content="Medir fluidez e RAM ao jogar"
                                          ToolTip="Grava os tempos dos fotogramas, as causas das pausas e o uso de RAM. Desliga a geração de fotogramas durante a medição."/>
                                <CheckBox x:Name="LowMemory" Margin="0,0,0,5" Content="Poupar RAM ao jogar"
                                          ToolTip="Evita carregar a cache Vulkan do jogo. Pode haver mais pausas a compilar efeitos gráficos durante a partida."/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="EnableDlss" Content="NVIDIA DLSS 4.5 e Multi Frame Generation"
                                          ToolTip="Descarrega o SDK oficial da NVIDIA ao compilar ou atualizar."/>
                                <TextBlock Margin="10,0,0,0">
                                    <Hyperlink Foreground="{StaticResource Cyan}" Click="OpenNvidiaLicense">Licença NVIDIA</Hyperlink>
                                </TextBlock>
                            </WrapPanel>
                            <WrapPanel Margin="0,5,0,0">
                                <CheckBox x:Name="EnableFsr4" Content="AMD FSR 4 em placas compatíveis"
                                          ToolTip="Descarrega os componentes AMD para reconstrução de imagem FSR 4. Podes preparar a instalação noutro PC."/>
                                <TextBlock Margin="10,0,0,0">
                                    <Hyperlink Foreground="{StaticResource Cyan}" Click="OpenAmdLicense">Licença AMD</Hyperlink>
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock Text="O FSR 3.1, incluindo a geração de fotogramas 2×, vem incluído e pode ser selecionado no jogo."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="HardwareInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ImportButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Content="Importar saves" Click="ImportSaves"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="No emulador, abre a pasta de saves do Ocarina of Time. Seleciona a pasta que contém as subpastas slot_00, slot_01, etc."
                                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="SaveSelection" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Status" Text="Escolhe a tua cópia do jogo" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="Percent" Grid.Column="1" Foreground="{StaticResource Cyan}" Margin="12,0,0,0"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressBar" Height="5" Margin="0,9,0,0" Maximum="1"
                                         Foreground="{StaticResource Cyan}" Background="#263956" BorderThickness="0"/>
                            <TextBlock x:Name="Detail" Text="As ferramentas são preparadas no primeiro uso." Foreground="{StaticResource Muted}"
                                       Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="CheckButton" Content="Verificar cópia" Click="CheckGame" Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton" Content="Cancelar" Click="CancelOperation" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="PlayButton" Content="Jogar" Click="PlayGame" Margin="0,0,8,0"/>
                        <Button x:Name="BuildButton" Style="{StaticResource Primary}" Content="Compilar jogo" Click="BuildGame" MinWidth="132"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LogPage" Visibility="Collapsed" Margin="26,24,26,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Registo de compilação" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Registo de compilação"/>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Abrir pasta do jogo" Click="OpenGameFolder" Margin="0,0,8,0"/>
                    <Button Content="Logs do jogo" Click="OpenGameLogs" Margin="0,0,8,0"/>
                    <Button Content="Abrir registo de compilação" Click="OpenLogFile"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
